+		reg = <0x15>;
+	};
+};
+
+/* ---------------------------------------------- Type-C role switch (DWC3) -- */
+&usb_host0_xhci {
+	dr_mode = "otg";
+	usb-role-switch;
+	status = "okay";
+
+	port {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		usbdrd_dwc3_ep: endpoint@0 {
+			reg = <0>;
+			remote-endpoint = <&fusb302_ep>;
+		};
+	};
