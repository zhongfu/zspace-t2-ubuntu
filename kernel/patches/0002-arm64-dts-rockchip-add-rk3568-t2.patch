From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: zhongfu <me@zhongfu.li>
Date: Tue, 30 Sep 2026 13:00:01 +0000
Subject: [PATCH 2/5] arm64: dts: rockchip: add the ZSpace T2 (RK3568)

The ZSpace T2 is an RK3568 portable NAS: eMMC boot, two M.2 slots on a
bifurcated PCIe 3.0 PHY, an Ampak AP6275P (BCM43752) WiFi/BT module on
pcie2x1, RTL8156B USB NIC behind the RJ45, HDMI, a PWM fan and six ADC keys.

The AP6275P hangs off pcie2x1 with its power gate (gpio2 PB1, the vendor's
vcc3v3_pcie20_wifi) wired as the ordinary vpcie3v3 supply; the driver quirk in
0001 handles the module's unusual bring-up.  Peripherals this board does not use
are left `status = "disabled"` in the board DTS; the comments below say why.

Signed-off-by: zhongfu <me@zhongfu.li>
---
diff --git a/arch/arm64/boot/dts/rockchip/Makefile b/arch/arm64/boot/dts/rockchip/Makefile
index e7936a21c118..bd77bad158f8 100644
--- a/arch/arm64/boot/dts/rockchip/Makefile
+++ b/arch/arm64/boot/dts/rockchip/Makefile
@@ -165,6 +165,7 @@ dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3568-radxa-e25.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3568-roc-pc.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3568-rock-3a.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3568-rock-3b.dtb
+dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3568-t2.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3568-wolfvision-pf5.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3568-wolfvision-pf5-display-vz.dtbo
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3568-wolfvision-pf5-io-expander.dtbo
diff --git a/arch/arm64/boot/dts/rockchip/rk3568-t2.dts b/arch/arm64/boot/dts/rockchip/rk3568-t2.dts
new file mode 100644
index 000000000000..105e28056585
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3568-t2.dts
@@ -0,0 +1,1228 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * ZSpace T2 - portable RK3568 NAS.
+ *
+ * Mainline port of the vendor board file. The vendor/BSP tree was based on
+ * rk3568-evb1-ddr4-v10, and the BSP board file rk3568-t2.dts is that board
+ * plus the T2's deltas - the parts the EVB does not have (2x M.2 PCIe,
+ * AP6275P SDIO WiFi, RTC, fan, front-panel LEDs and ADC keys) and the EVB
+ * parts the T2 does not have (GMACs, SATA, DSI/EDP, cameras, codec).
+ *
+ * Unlike the BSP, which includes a .dtsi, mainline has no reusable EVB .dtsi
+ * (rk3568-evb1-v10.dts is a leaf board file), so this file follows the common
+ * mainline rk3568 pattern: include the SoC dtsi and describe the board
+ * supplies/PMIC inline (see rk3568-nanopi-r5s.dtsi / rk3568-photonicat.dts).
+ *
+ * Vendor-only nodes (wlan-platdata, bluetooth-platdata, rockchip-suspend) have
+ * no mainline driver and are dropped: the AP6275P is driven by brcmfmac on the
+ * sdmmc1 SDIO bus with mmc-pwrseq-simple power sequencing; the RTC (hym8563)
+ * supplies the SDIO reference clock.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/linux-event-codes.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/pinctrl/rockchip.h>
+#include <dt-bindings/soc/rockchip,vop2.h>
+#include "rk3568.dtsi"
+
+/ {
+	model = "ZSpace T2";
+	compatible = "zspace,t2", "rockchip,rk3568";
+
+	aliases {
+		mmc0 = &sdhci;
+		mmc1 = &sdmmc0;   /* the SD card slot (not sdmmc1, which is off) */
+	};
+
+	chosen: chosen {
+		stdout-path = "serial2:1500000n8";
+		/*
+		 * Root is p6 (vendor PARTLABEL "rootfs", 14 GiB), addressed by
+		 * *filesystem label* - the distro builder always writes
+		 * LABEL=zspace-rootfs (see distro/profiles/t2-base/image.json),
+		 * and the label survives both a GPT reshape and a rebuild that
+		 * picks a fresh fs UUID.
+		 *
+		 * Do NOT use the short PARTUUID here: p6 is
+		 * 614e0000-0000-4b53-8000-1d28000054a9, and the embedded
+		 * bring-up initramfs cannot resolve PARTUUID at all (busybox
+		 * 1.36 findfs understands only LABEL=/UUID=), and a bare
+		 * `root=PARTUUID=614e0000-0000` is resolved by prefix and was
+		 * measured to boot p11 instead of p6.
+		 *
+		 * FLASH ORDER: write the distro rootfs to p6 FIRST, then this
+		 * FIT - booting this FIT while p6 still holds the vendor ZOS
+		 * rootfs runs our kernel against their userspace.  p11
+		 * ("source_rootfs") was the bring-up staging partition.
+		 */
+		bootargs = "earlycon=uart8250,mmio32,0xfe660000 console=ttyS2,1500000n8 root=LABEL=zspace-rootfs rootfstype=ext4 rw rootwait rootflags=errors=remount-ro panic=15";
+	};
+
+	/*
+	 * Persistent store for a kernel hang.  Values are the *vendor's own*,
+	 * read from the vendor boot image's FDT (the FDT at offset 0x800,
+	 * compatible = "zspace,t2"), not transcribed:
+	 *
+	 *     ramoops@110000 {
+	 *         compatible = "ramoops";
+	 *         reg = <0x00 0x110000 0x00 0xf0000>;
+	 *         record-size = <0x20000>;
+	 *         console-size = <0x80000>;
+	 *         ftrace-size = <0x00>;
+	 *         pmsg-size = <0x50000>;
+	 *     };
+	 *
+	 * Cross-check (all against the vendor FIT):
+	 * BL31 sits at 0x40000..~0x61000 and 0xfdcc1000..0xfdcd2000, U-Boot at
+	 * 0x800000, and the kernel is loaded/entered at 0x280000 - so
+	 * 0x110000..0x200000 is free and does not overlap ATF, U-Boot or the
+	 * kernel image.  record + console + pmsg = 0x20000 + 0x80000 + 0x50000
+	 * = 0xf0000 = the reg size exactly.
+	 */
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		ramoops: ramoops@110000 {
+			compatible = "ramoops";
+			reg = <0x00 0x110000 0x00 0xf0000>;
+			record-size = <0x20000>;
+			console-size = <0x80000>;
+			ftrace-size = <0x00>;
+			pmsg-size = <0x50000>;
+		};
+	};
+
+	dc_12v: regulator-dc-12v {
+		compatible = "regulator-fixed";
+		regulator-name = "dc_12v";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <12000000>;
+		regulator-max-microvolt = <12000000>;
+	};
+
+	vcc3v3_sys: regulator-vcc3v3-sys {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc3v3_sys";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		vin-supply = <&dc_12v>;
+	};
+
+	vcc5v0_sys: regulator-vcc5v0-sys {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc5v0_sys";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		vin-supply = <&dc_12v>;
+	};
+
+	/* 3.3V rail for the two M.2 slots, gated on gpio0 PD4 */
+	vcc3v3_pcie: regulator-vcc3v3-pcie {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc3v3_pcie";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		enable-active-high;
+		gpios = <&gpio0 RK_PD4 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&vcc3v3_pcie_en>;
+		startup-delay-us = <5000>;
+		vin-supply = <&vcc3v3_sys>;
+	};
+
+	/* AP6275P WiFi/PCIe power enable - gpio2 PB1, the vendor's
+	 * vcc3v3_pcie20_wifi gate.  Wired as pcie2x1's vpcie3v3 supply, the
+	 * idiomatic way.
+	 *
+	 * This module is why patches/0001-pci-dw-rockchip-endpoint-power-
+	 * cycle-retry.patch exists: the BCM43752 only brings its link up once
+	 * it has been power-cycled with the PHY already running and PERST#
+	 * already released, which is later than dw_pcie_wait_for_link() waits.
+	 * The driver retries by cycling this supply - so do NOT make it
+	 * always-on or boot-on: that cycle is what brings the module up.
+	 */
+	vcc3v3_pcie20_wifi: vcc3v3-pcie20-wifi {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc3v3_pcie20_wifi";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		enable-active-high;
+		gpios = <&gpio2 RK_PB1 GPIO_ACTIVE_HIGH>;
+		/*
+		 * The vendor's value.  Note it is spent *inside* phy_power_on()
+		 * (where phy-core enables this supply), so it is simply time
+		 * the module gets powered before the rest of the probe runs.
+		 */
+		startup-delay-us = <200000>;
+		vin-supply = <&dc_12v>;
+	};
+
+	/* fan 12V switch (gpio0 RK_PC7); pwm0 channel drives speed */
+	fan_12v: fan-12v-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc12v_fan";
+		regulator-min-microvolt = <12000000>;
+		regulator-max-microvolt = <12000000>;
+		enable-active-high;
+		gpios = <&gpio0 RK_PC7 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&fan_12v_ctrl_gpio>;
+		vin-supply = <&dc_12v>;
+	};
+
+	vbus_typec: vbus-typec-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "vbus_typec";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		enable-active-high;
+		gpios = <&gpio3 RK_PC4 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&vcc5v0_typec0_en>;
+		vin-supply = <&vcc5v0_sys>;
+	};
+
+	/*
+	 * gpio0 PA5 and gpio3 PB0 together gate the onboard VIA Labs VL817 USB
+	 * hub, which carries both the user-facing USB-A port and the RTL8156B
+	 * NIC behind the RJ-45.  The vendor U-Boot drives both high before
+	 * "starting USB..."; mainline U-Boot 2026.07 does neither and nothing
+	 * here modelled the pins, so the hub never came up at all (no USB-A, no
+	 * onboard NIC) even though the host controllers and PHYs were fine.
+	 *
+	 * Measured 2026-10-02 on a live boot: driving PB0 alone (hold, and a
+	 * low->high pulse) does nothing; driving PB0 *and* PA5 brings up the
+	 * hub, the USB-A port and r8152.  PB0 must stay high (see the hog on
+	 * &gpio3), PA5 only has to be high while the hub comes up - the vendor's
+	 * own kernel disables its equivalent at t=44.7s with the hub staying up.
+	 * Held always-on here anyway: it is harmless, and it keeps the hub
+	 * usable no matter when a driver re-probes.
+	 */
+	vcc5v0_otg: vcc5v0-otg-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc5v0_otg";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		enable-active-high;
+		gpios = <&gpio0 RK_PA5 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&vcc5v0_otg_en>;
+		regulator-always-on;
+		regulator-boot-on;
+		vin-supply = <&vcc5v0_sys>;
+	};
+
+	/*
+	 * The vendor's fan driver is not needed: generic pwm-fan has carried the
+	 * tachometer path since v5.2 (6b1ec4789fb1), so the same node reports
+	 * RPM as hwmon `fan1_input` from the tach pin's edges.  pwm-fan counts
+	 * them on an IRQ (`interrupts`, self-resetting edge) and divides by
+	 * `pulses-per-revolution`; 2 is the binding's default and the value to
+	 * tune if fan1_input comes out off by a constant factor.
+	 */
+	fan: pwm-fan {
+		compatible = "pwm-fan";
+		pwms = <&pwm0 0 25000 0>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&fan_tach_int>;
+		fan-supply = <&fan_12v>;
+		#cooling-cells = <2>;
+		cooling-levels = <0 64 128 192 255>;
+		interrupt-parent = <&gpio0>;
+		interrupts = <RK_PC6 IRQ_TYPE_EDGE_FALLING>;
+		pulses-per-revolution = <2>;
+	};
+
+	/* AP6275P SDIO WiFi power sequencing; the ext clock comes from the RTC */
+	t2_sdio_pwrseq: t2-sdio-pwrseq {
+		compatible = "mmc-pwrseq-simple";
+		clocks = <&hym8563>;
+		clock-names = "ext_clock";
+		pinctrl-names = "default";
+		pinctrl-0 = <&wifi_enable_h>;
+		/* gpio2 PB1 is ONE net on this board: it enables the
+		 * vcc3v3_pcie20_wifi rail *and* drives the AP6275P power/reset
+		 * (the vendor asks for it non-exclusively from both nodes).
+		 * Mainline cannot double-claim a GPIO, so the regulator owns it
+		 * and this pwrseq contributes only the delay + ext clock. */
+		post-power-on-delay-ms = <200>;
+	};
+
+	z2s_leds: z2s-leds {
+		compatible = "gpio-leds";
+		pinctrl-names = "default";
+		pinctrl-0 = <&hdd1_green_gpio &hdd1_red_gpio &hdd2_green_gpio
+			     &hdd2_red_gpio &power_green_gpio &power_red_gpio>;
+
+		hdd1-green {
+			gpios = <&gpio1 RK_PA5 GPIO_ACTIVE_HIGH>;
+			label = "hdd1-led-green";
+			linux,default-trigger = "disk-activity";
+		};
+		hdd1-red {
+			gpios = <&gpio1 RK_PA4 GPIO_ACTIVE_HIGH>;
+			label = "hdd1-led-red";
+		};
+		hdd2-green {
+			gpios = <&gpio1 RK_PA3 GPIO_ACTIVE_HIGH>;
+			label = "hdd2-led-green";
+			linux,default-trigger = "disk-activity";
+		};
+		hdd2-red {
+			gpios = <&gpio1 RK_PA2 GPIO_ACTIVE_HIGH>;
+			label = "hdd2-led-red";
+		};
+		power-green {
+			gpios = <&gpio1 RK_PA7 GPIO_ACTIVE_HIGH>;
+			label = "power-led-green";
+			linux,default-trigger = "default-on";
+			default-state = "on";
+		};
+		power-red {
+			gpios = <&gpio1 RK_PA6 GPIO_ACTIVE_HIGH>;
+			label = "power-led-red";
+			default-state = "off";
+		};
+	};
+
+	/* Buttons - all six sit on the SARADC.  Ground truth is the vendor tree's
+	 * `adc-keys*` nodes (resource_rk-kernel.dts:5552-5632):
+	 *
+	 *   ch0  volume up        0.00175 V   <- vendor value; almost certainly a
+	 *                                        vendor bug (all others are 1.0-1.2 V),
+	 *                                        kept verbatim rather than invented
+	 *   ch1  production line  1.00 V      } the three factory buttons on the PCB
+	 *   ch2  ageing           1.20 V      } next to the RAM
+	 *   ch3  dev              1.20 V      }
+	 *   ch4  power_key_bk     1.00 V
+	 *   ch5  reset_key_bk     1.00 V
+	 *
+	 * (An earlier revision of this file guessed "recovery" on ch0 and "reset" on
+	 * ch1 with invented 0.2 V thresholds - both wrong, fixed here.) */
+	adc_keys_volup: adc-keys-volup {
+		compatible = "adc-keys";
+		io-channels = <&saradc 0>;
+		io-channel-names = "buttons";
+		keyup-threshold-microvolt = <1700000>;
+		poll-interval = <100>;
+
+		volume-up-key {
+			label = "volume-up";
+			linux,code = <KEY_VOLUMEUP>;
+			press-threshold-microvolt = <1750>;
+		};
+	};
+
+	adc_keys_prodline: adc-keys-prodline {
+		compatible = "adc-keys";
+		io-channels = <&saradc 1>;
+		io-channel-names = "buttons";
+		keyup-threshold-microvolt = <1700000>;
+		poll-interval = <100>;
+
+		production-line-key {
+			label = "production-line";
+			linux,code = <KEY_KPPLUS>;
+			press-threshold-microvolt = <1000000>;
+		};
+	};
+
+	adc_keys_ageing: adc-keys-ageing {
+		compatible = "adc-keys";
+		io-channels = <&saradc 2>;
+		io-channel-names = "buttons";
+		keyup-threshold-microvolt = <1700000>;
+		poll-interval = <100>;
+
+		ageing-key {
+			label = "ageing";
+			linux,code = <KEY_MENU>;
+			press-threshold-microvolt = <1200000>;
+		};
+	};
+
+	adc_keys_dev: adc-keys-dev {
+		compatible = "adc-keys";
+		io-channels = <&saradc 3>;
+		io-channel-names = "buttons";
+		keyup-threshold-microvolt = <1700000>;
+		poll-interval = <100>;
+
+		dev-key {
+			label = "dev";
+			linux,code = <KEY_BACK>;
+			press-threshold-microvolt = <1200000>;
+		};
+	};
+
+	adc_keys_power_bk: adc-keys-power-bk {
+		compatible = "adc-keys";
+		io-channels = <&saradc 4>;
+		io-channel-names = "buttons";
+		keyup-threshold-microvolt = <1700000>;
+		poll-interval = <100>;
+
+		power-key-bk {
+			label = "power-key-bk";
+			linux,code = <KEY_UP>;
+			press-threshold-microvolt = <1000000>;
+		};
+	};
+
+	adc_keys_reset_bk: adc-keys-reset-bk {
+		compatible = "adc-keys";
+		io-channels = <&saradc 5>;
+		io-channel-names = "buttons";
+		keyup-threshold-microvolt = <1700000>;
+		poll-interval = <100>;
+
+		reset-key-bk {
+			label = "reset-key-bk";
+			linux,code = <KEY_DOWN>;
+			press-threshold-microvolt = <1000000>;
+		};
+	};
+
+	hdmi-con {
+		compatible = "hdmi-connector";
+		type = "a";
+
+		port {
+			hdmi_con_in: endpoint {
+				remote-endpoint = <&hdmi_out_con>;
+			};
+		};
+	};
+};
+
+/* --------------------------------------------------------------- CPU idle -- */
+/* The vendor tree gives every CPU `cpu-idle-states = <&CPU_SLEEP>` and defines
+ * a single PSCI CPU power-down state ("idle-states" node, phandle 0x04 in
+ * resource_rk-kernel.dts).  Mainline ships ARM_PSCI_CPUIDLE=y but the rk356x
+ * dtsi declares no idle-states, so before this the cores could only WFI and
+ * `/sys/devices/system/cpu/cpu0/cpuidle/` was empty.  The vendor firmware (the
+ * ATF in the untouched `trust` partition) implements this suspend param, so the
+ * same state is valid here. */
+&{/cpus} {
+	idle-states {
+		entry-method = "psci";
+
+		CPU_SLEEP: cpu-sleep {
+			compatible = "arm,idle-state";
+			local-timer-stop;
+			arm,psci-suspend-param = <0x0010000>;
+			entry-latency-us = <100>;
+			exit-latency-us = <120>;
+			min-residency-us = <1000>;
+		};
+	};
+};
+
+&cpu0 { cpu-idle-states = <&CPU_SLEEP>; };
+&cpu1 { cpu-idle-states = <&CPU_SLEEP>; };
+&cpu2 { cpu-idle-states = <&CPU_SLEEP>; };
+&cpu3 { cpu-idle-states = <&CPU_SLEEP>; };
+
+/* ---------------------------------------------------------------- storage -- */
+&sdhci {
+	status = "okay";
+	bus-width = <8>;
+	max-frequency = <200000000>;
+	non-removable;
+	pinctrl-names = "default";
+	pinctrl-0 = <&emmc_bus8 &emmc_clk &emmc_cmd &emmc_datastrobe>;
+};
+
+/* The T2's SD card slot is **sdmmc0 (fe2b0000)**: the vendor node is
+ * "supports-sd" with vmmc=vcc3v3_sd, vqmmc=vccio_sd and card-detect on
+ * gpio0 PA4, driven by the pin's func-1 SD-detect function - which is why the
+ * node below has no cd-gpios (see the comment there for the bug that caused).
+ *
+ * NOTE the vendor's WiFi SDIO controllers - sdmmc1 (fe2c0000) and sdmmc2
+ * (fe000000) - are **both disabled**, so this T2 has no WiFi even though its
+ * rootfs ships AP6275P firmware.  sdmmc1 is left at its dtsi default. */
+&sdmmc0 {
+	status = "okay";
+	bus-width = <4>;
+	cap-sd-highspeed;
+	cap-mmc-highspeed;
+	sd-uhs-sdr104;
+	disable-wp;
+	/* The vendor drives this pin with its func-1 SD-detect, and with no
+	 * gpio mainline's dw_mci_get_cd() reads the controller's CDETECT
+	 * register - tried first, and it never saw the card.  So try the gpio
+	 * route with a card actually fitted: the pin reads low, which
+	 * ACTIVE_LOW calls "present", so the core will attempt the card.
+	 * (Without a card this exact config looped mmc_rescan into a BUG in
+	 * mmc_power_up - if that recurs, power-cycle and revert this line.) */
+	cd-gpios = <&gpio0 RK_PA4 GPIO_ACTIVE_LOW>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&sdmmc0_bus4 &sdmmc0_clk &sdmmc0_cmd &sdmmc0_det>;
+	vmmc-supply = <&vcc3v3_sd>;
+	vqmmc-supply = <&vccio_sd>;
+};
+
+/* WiFi half of the AP6275P (an SDIO device) - NOT REACHABLE on this unit.
+ * Both candidate buses were enabled and probed with the module's power rail
+ * live (the Bluetooth half of the *same* module works, so the module is
+ * definitely fitted):
+ *   sdmmc1 = fe2c0000, pinctrl sdmmc1_bus4/clk/cmd -> "Failed to initialize a
+ *                                                     non-removable card"
+ *   sdmmc2 = fe000000, pinctrl sdmmc2m0_bus4/clk/cmd (the vendor's own wiring)
+ *                                                  -> same
+ * So neither controller sees an SDIO device; brcmfmac never binds.  Left
+ * disabled.  Re-enabling is a one-line change if the routing is ever found. */
+&sdmmc2 {
+	status = "disabled";
+};
+
+/* ------------------------------------------------------------------ PCIe -- */
+/* one x1 gen2 (the AP6275P WiFi) + two M.2 slots */
+/*
+ * The WiFi module's supply has to be power-cycled before it will train;
+ * that is what patches/0001-pci-dw-rockchip-endpoint-power-cycle-retry.patch
+ * adds to the driver.  The wiring here is the ordinary one.
+ */
+&pcie2x1 {
+	status = "okay";   /* x1 gen2: the AP6275P WiFi module */
+	reset-gpios = <&gpio3 RK_PC1 GPIO_ACTIVE_HIGH>;
+	/*
+	 * Deliberately no rockchip,perst-inactive-ms: the vendor defines it and
+	 * the BSP driver parses it, but **no mainline driver does** - mainline
+	 * uses the PCIe spec's PCIE_T_PVPERL_MS (100 ms) unconditionally, so a
+	 * value here would read as if it were honoured while doing nothing
+	 * (verified 2026-10-01: the string appears only in DTS files across the
+	 * tree, never in drivers/).  The AP6275P datasheet §8.1 wants >=150 ms
+	 * from rails-valid to the first PCIe config access; the rail's 200 ms
+	 * startup-delay-us covers that - see the regulator node above.
+	 */
+	vpcie3v3-supply = <&vcc3v3_pcie20_wifi>;
+};
+
+&pcie3x1 {
+	status = "okay";
+	reset-gpios = <&gpio3 RK_PA1 GPIO_ACTIVE_HIGH>;
+	vpcie3v3-supply = <&vcc3v3_pcie>;
+};
+
+&pcie3x2 {
+	status = "okay";
+	/* each M.2 slot is x1 on a bifurcated pcie30phy - same topology as
+	 * rk3568-nanopi-r5s (the dtsi default is num-lanes = 2) */
+	num-lanes = <1>;
+	reset-gpios = <&gpio2 RK_PD6 GPIO_ACTIVE_HIGH>;
+	vpcie3v3-supply = <&vcc3v3_pcie>;
+};
+
+/* the PCIe PHYs the controllers consume */
+&combphy2 {
+	status = "okay";   /* PCIe mode, consumed by pcie2x1 */
+};
+&pcie30phy {
+	/* pcie30_phymode: bifurcation, one x1 lane per M.2 slot.  Without this
+	 * the driver assumes aggregation (lane 0 only) and the second slot's
+	 * link never trains. */
+	data-lanes = <1 2>;
+	status = "okay";
+};
+
+/* ------------------------------------------------------- USB-C PD (i2c0) -- */
+/* The T2 is powered through this port, so the PD sink contract matters. */
+&i2c0 {
+	status = "okay";
+
+	vdd_cpu: regulator@1c {
+		compatible = "tcs,tcs4525";
+		reg = <0x1c>;
+		fcs,suspend-voltage-selector = <1>;
+		regulator-name = "vdd_cpu";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <800000>;
+		regulator-max-microvolt = <1150000>;
+		regulator-ramp-delay = <2300>;
+		vin-supply = <&vcc5v0_sys>;
+
+		regulator-state-mem {
+			regulator-off-in-suspend;
+		};
+	};
+
+	rk809: pmic@20 {
+		compatible = "rockchip,rk809";
+		reg = <0x20>;
+		interrupt-parent = <&gpio0>;
+		interrupts = <RK_PA3 IRQ_TYPE_LEVEL_LOW>;
+		assigned-clocks = <&cru I2S1_MCLKOUT_TX>;
+		assigned-clock-parents = <&cru CLK_I2S1_8CH_TX>;
+		#clock-cells = <1>;
+		clock-names = "mclk";
+		clocks = <&cru I2S1_MCLKOUT_TX>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pmic_int>;
+		system-power-controller;
+		#sound-dai-cells = <0>;
+		vcc1-supply = <&vcc3v3_sys>;
+		vcc2-supply = <&vcc3v3_sys>;
+		vcc3-supply = <&vcc3v3_sys>;
+		vcc4-supply = <&vcc3v3_sys>;
+		vcc5-supply = <&vcc3v3_sys>;
+		vcc6-supply = <&vcc3v3_sys>;
+		vcc7-supply = <&vcc3v3_sys>;
+		vcc8-supply = <&vcc3v3_sys>;
+		vcc9-supply = <&vcc3v3_sys>;
+		wakeup-source;
+
+		regulators {
+			vdd_logic: DCDC_REG1 {
+				regulator-name = "vdd_logic";
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-initial-mode = <0x2>;
+				regulator-min-microvolt = <500000>;
+				regulator-max-microvolt = <1350000>;
+				regulator-ramp-delay = <6001>;
+
+				regulator-state-mem {
+					regulator-off-in-suspend;
+				};
+			};
+
+			vdd_gpu: DCDC_REG2 {
+				regulator-name = "vdd_gpu";
+				regulator-always-on;
+				regulator-initial-mode = <0x2>;
+				regulator-min-microvolt = <500000>;
+				regulator-max-microvolt = <1350000>;
+				regulator-ramp-delay = <6001>;
+
+				regulator-state-mem {
+					regulator-off-in-suspend;
+				};
+			};
+
+			vcc_ddr: DCDC_REG3 {
+				regulator-name = "vcc_ddr";
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-initial-mode = <0x2>;
+
+				regulator-state-mem {
+					regulator-on-in-suspend;
+				};
+			};
+
+			vdd_npu: DCDC_REG4 {
+				regulator-name = "vdd_npu";
+				regulator-initial-mode = <0x2>;
+				regulator-min-microvolt = <500000>;
+				regulator-max-microvolt = <1350000>;
+				regulator-ramp-delay = <6001>;
+
+				regulator-state-mem {
+					regulator-off-in-suspend;
+				};
+			};
+
+			vcc_1v8: DCDC_REG5 {
+				regulator-name = "vcc_1v8";
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+
+				regulator-state-mem {
+					regulator-off-in-suspend;
+				};
+			};
+
+			vdda0v9_image: LDO_REG1 {
+				regulator-name = "vdda0v9_image";
+				regulator-min-microvolt = <900000>;
+				regulator-max-microvolt = <900000>;
+
+				regulator-state-mem {
+					regulator-off-in-suspend;
+				};
+			};
+
+			vdda_0v9: LDO_REG2 {
+				regulator-name = "vdda_0v9";
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <900000>;
+				regulator-max-microvolt = <900000>;
+
+				regulator-state-mem {
+					regulator-off-in-suspend;
+				};
+			};
+
+			vdda0v9_pmu: LDO_REG3 {
+				regulator-name = "vdda0v9_pmu";
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <900000>;
+				regulator-max-microvolt = <900000>;
+
+				regulator-state-mem {
+					regulator-on-in-suspend;
+					regulator-suspend-microvolt = <900000>;
+				};
+			};
+
+			vccio_acodec: LDO_REG4 {
+				regulator-name = "vccio_acodec";
+				regulator-always-on;
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+
+				regulator-state-mem {
+					regulator-off-in-suspend;
+				};
+			};
+
+			vccio_sd: LDO_REG5 {
+				regulator-name = "vccio_sd";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <3300000>;
+				/* vendor keeps both SD rails always-on; without this
+				 * the SD card is unpowered outside a probe */
+				regulator-always-on;
+				regulator-boot-on;
+
+				regulator-state-mem {
+					regulator-off-in-suspend;
+				};
+			};
+
+			vcc3v3_pmu: LDO_REG6 {
+				regulator-name = "vcc3v3_pmu";
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+
+				regulator-state-mem {
+					regulator-on-in-suspend;
+					regulator-suspend-microvolt = <3300000>;
+				};
+			};
+
+			vcca_1v8: LDO_REG7 {
+				regulator-name = "vcca_1v8";
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+
+				regulator-state-mem {
+					regulator-off-in-suspend;
+				};
+			};
+
+			vcca1v8_pmu: LDO_REG8 {
+				regulator-name = "vcca1v8_pmu";
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+
+				regulator-state-mem {
+					regulator-on-in-suspend;
+					regulator-suspend-microvolt = <1800000>;
+				};
+			};
+
+			vcca1v8_image: LDO_REG9 {
+				regulator-name = "vcca1v8_image";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+
+				regulator-state-mem {
+					regulator-off-in-suspend;
+				};
+			};
+
+			vcc_3v3: SWITCH_REG1 {
+				regulator-name = "vcc_3v3";
+				regulator-always-on;
+				regulator-boot-on;
+
+				regulator-state-mem {
+					regulator-off-in-suspend;
+				};
+			};
+
+			vcc3v3_sd: SWITCH_REG2 {
+				regulator-name = "vcc3v3_sd";
+				/* see vccio_sd - the vendor keeps this on too */
+				regulator-always-on;
+				regulator-boot-on;
+
+				regulator-state-mem {
+					regulator-off-in-suspend;
+				};
+			};
+		};
+
+		codec {
+			rockchip,mic-in-differential;
+			/* T2 has no RK809 analog audio: the vendor disables this
+			 * codec so gpio1-2 can serve as the hdd2-red LED. */
+			status = "disabled";
+		};
+	};
+
+	fusb302: typec-portc@22 {
+		compatible = "fcs,fusb302";
+		reg = <0x22>;
+		interrupt-parent = <&gpio0>;
+		interrupts = <RK_PA6 IRQ_TYPE_LEVEL_LOW>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&usbc0_int>;
+		vbus-supply = <&vbus_typec>;
+
+		connector {
+			compatible = "usb-c-connector";
+			label = "USB-C";
+			data-role = "dual";
+			power-role = "dual";
+			try-power-role = "sink";
+			op-sink-microwatt = <1000000>;
+			sink-pdos = <0x40190fa>;
+			source-pdos = <0x4019096>;
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+
+					fusb302_ep: endpoint {
+						remote-endpoint = <&usbdrd_dwc3_ep>;
+					};
+				};
+			};
+		};
+	};
+};
+
+/* ------------------------------------------------------------ i2c5: RTC --- */
+&i2c5 {
+	status = "okay";
+
+	hym8563: rtc@51 {
+		compatible = "haoyu,hym8563";
+		reg = <0x51>;
+		#clock-cells = <0>;
+		clock-frequency = <32768>;
+		clock-output-names = "hym8563";
+		pinctrl-names = "default";
+		pinctrl-0 = <&hym8563_irq_gpio>;
+	};
