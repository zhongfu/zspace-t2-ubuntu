+/* ----------------------------------------------- parts of the EVB the T2
+ * lacks (GMAC, SATA, DSI/EDP, cameras, codec, EHCI/OHCI on the OTG port) --
+ * these are disabled by default in mainline rk3568, so only the ones the
+ * vendor explicitly turned off are listed here for parity with the BSP. */
+
+/* ------------------------------------------------- the T2 needs these on -- */
+&combphy0 {
+	status = "okay";   /* USB3 on the USB-C OTG port */
+};
+&combphy1 {
+	status = "okay";   /* USB3 on the USB-A host port */
+};
+
+/*
+ * The other half of the onboard VL817 hub gate (see vcc5v0_otg).  A hog
+ * rather than a regulator because the level must be *held* high for the hub
+ * to stay up, and requesting the line in gpiolib also muxes it to GPIO.
+ * Vendor U-Boot drives "gpio3_b0" high in board init, immediately before
+ * "starting USB..."; mainline U-Boot does not, so without this the hub (and
+ * therefore the USB-A port and the onboard NIC) is electrically invisible.
+ */
+&gpio3 {
+	usb_hub_en_hog: usb-hub-en-hog {
+		gpio-hog;
+		gpios = <RK_PB0 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "usb-hub-en";
+	};
+};
+
+/*
+ * Type-C SuperSpeed data mux select (the vendor calls it the USB data mux).
+ * The vendor's fusb302 fork drives gpio4 PD2 through the typec-switch
+ * framework; mainline has no driver for it, and left floating the USB-C port
+ * negotiates USB 2.0 only.  Measured 2026-10-02 on a live boot by rebinding
+ * the UDC to force a fresh negotiation:
+ *     PD2 low (0)  -> /sys/class/udc/fcc00000.usb/current_speed = high-speed
+ *     PD2 high (1) -> current_speed = super-speed
+ * Held high here: SuperSpeed then works in one cable orientation, and the
+ * other orientation still degrades to USB 2.0 - which is exactly what it did
+ * with the pin untouched, so this cannot regress the link.  The proper fix is
+ * an orientation switch driven by the fusb302 (it reports orientation in
+ * mainline); this is the minimal version.
+ */
+&gpio4 {
+	usb_ss_mux_hog: usb-ss-mux-hog {
+		gpio-hog;
+		gpios = <RK_PD2 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "usb-ss-mux";
+	};
+};
+
+&cpu0 {
+	cpu-supply = <&vdd_cpu>;
+};
+&cpu1 {
+	cpu-supply = <&vdd_cpu>;
+};
+&cpu2 {
+	cpu-supply = <&vdd_cpu>;
+};
+&cpu3 {
+	cpu-supply = <&vdd_cpu>;
+};
+
+&gpu {
+	mali-supply = <&vdd_gpu>;
+	status = "okay";
+};
+
+/* HDMI stays enabled - mainline dw-hdmi handles the internal PHY */
+&hdmi {
+	avdd-0v9-supply = <&vdda0v9_image>;
+	avdd-1v8-supply = <&vcca1v8_image>;
+	/* The DDC (SCL/SDA) pins must be muxed or the EDID cannot be read and
+	 * the connector reports "connected" with no modes.  The T2 wires CEC to
+	 * hdmitxm0 (gpio4 PD1), matching the vendor - not hdmitxm1 like rock-3a. */
+	pinctrl-names = "default";
+	pinctrl-0 = <&hdmitx_scl &hdmitx_sda &hdmitxm0_cec>;
+	status = "okay";
+};
+
+&hdmi_in {
+	hdmi_in_vp0: endpoint {
+		remote-endpoint = <&vp0_out_hdmi>;
+	};
+};
+
+&hdmi_out {
+	hdmi_out_con: endpoint {
+		remote-endpoint = <&hdmi_con_in>;
+	};
+};
+
+&hdmi_sound {
+	status = "okay";
+};
+
+&i2s0_8ch {
+	status = "okay";    /* HDMI audio */
+};
+
+&pwm0 {
+	status = "okay";    /* fan */
+};
+
+&pmu_io_domains {
+	pmuio1-supply = <&vcc3v3_pmu>;
+	pmuio2-supply = <&vcc3v3_pmu>;
+	vccio1-supply = <&vccio_acodec>;
+	vccio2-supply = <&vcc_1v8>;
+	vccio3-supply = <&vccio_sd>;
+	vccio4-supply = <&vcc_1v8>;
+	vccio5-supply = <&vcc_3v3>;
+	vccio6-supply = <&vcc_1v8>;
+	vccio7-supply = <&vcc_3v3>;
+	status = "okay";
+};
+
+&power {
+	status = "okay";    /* power domains for the accelerators */
+};
+
+&saradc {
+	vref-supply = <&vcca_1v8>;
+	status = "okay";
+};
+
+&tsadc {
+	rockchip,hw-tshut-mode = <1>;
+	rockchip,hw-tshut-polarity = <0>;
+	status = "okay";
+};
+
+&uart1 {
+	status = "okay";    /* front panel / bluetooth */
+	/* uart1 drives the BT serdev: it needs DMA explicitly enabled (Rockchip
+	 * defaults uarts to non-DMA for console use) and both CTS/RTS muxed -
+	 * without them the first HCI command times out ("tx timeout"). */
+	dma-names = "tx", "rx";
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart1m0_xfer &uart1m0_ctsn &uart1m0_rtsn>;
+	uart-has-rtscts;
+
+	/* AP6275P (BCM43752) Bluetooth.  Pins taken from the vendor's
+	 * bluetooth-platdata: BT_REG_ON = gpio2 PB7, BT wake = gpio2 PC1,
+	 * RTS = gpio2 PB5 - the same wiring rk3568-lincstation-e1 uses.
+	 * The module's 32 kHz LPO comes from the RTC. */
+	bluetooth {
+		compatible = "brcm,bcm4345c5";
+		clocks = <&hym8563>;
+		clock-names = "lpo";
+		/* Broadcom binding: shutdown-gpios is BT_REG_ON.  (enable-gpios
+		 * is the Realtek binding - using it here is silently ignored,
+		 * which shows up as "No reset resource" + "BCM: Reset failed".) */
+		shutdown-gpios = <&gpio2 RK_PB7 GPIO_ACTIVE_HIGH>;
+		device-wakeup-gpios = <&gpio2 RK_PC1 GPIO_ACTIVE_HIGH>;
+		max-speed = <1500000>;
+	};
+};
+&uart2 {
+	status = "okay";    /* serial console (UART2, 0xfe660000) */
+};
+&uart3 {
+	status = "okay";
+};
+
+&usb_host1_ehci {
+	/*
+	 * The USB2 companion controllers of the USB3 host at fd000000.  They are
+	 * unused - their buses are bare root hubs and the T2 has no USB2-only
+	 * ports (every port's USB2 side enumerates on the DWC3's own root hub) -
+	 * but ohci-platform's .shutdown() register access hard-stalls the SoC on
+	 * this board, so every reboot/poweroff ends with an RCU stall and only
+	 * recovers via the watchdog.  Disabling them removes the device from the
+	 * shutdown walk (verified on the board, 2026-10-03).
+	 */
+	status = "disabled";
+};
+&usb_host1_ohci {
+	status = "disabled";
+};
+&usb_host1_xhci {
+	status = "okay";
+};
+
+&usb2phy0 {
+	status = "okay";
+};
+&usb2phy0_host {
+	status = "okay";
+};
+&usb2phy0_otg {
+	status = "okay";
+};
+&usb2phy1 {
+	status = "okay";
+};
+&usb2phy1_host {
+	status = "okay";
+};
+&usb2phy1_otg {
+	status = "okay";
+};
