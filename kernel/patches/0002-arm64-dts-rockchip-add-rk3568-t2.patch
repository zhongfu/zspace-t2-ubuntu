+/*
+ * Thermal policy: the fan is the first response, throttling the second.
+ *
+ * The base dtsi maps `map0` (the four cpufreq cooling devices) to
+ * `cpu_alert0` (70 °C) and carries no fan at all; our first cut added the fan
+ * on `cpu_alert1` (75 °C), so the CPU throttled *before* the fan was allowed to
+ * spin - backwards for a board that has a fan, since throttling costs
+ * performance and the fan costs nothing.  Swap the two: the fan comes on at
+ * 70 °C and throttling starts at 75 °C.  (Measured 2026-10-03: full 4-core load
+ * plateaus at 66 °C, so neither trip is reachable on the bench - the ordering
+ * only matters in a hot room.)
+ *
+ * Both maps stay on `passive` trips, which is what `power_allocator` requires
+ * if the governor is ever moved off the default `step_wise`.
+ *
+ * The GPU zone gets the same treatment: the fan on `gpu_threshold` (70 °C),
+ * with the base's devfreq map left on `gpu_target` (75 °C).  Caveat: the
+ * thermal core does not arbitrate a cooling device shared between zones, so
+ * when only one zone is hot the two governors can disagree about the fan's
+ * state (verified behaviour on the board).  It is acceptable here
+ * because both sensors sit on the same die, but one aggregating zone over both
+ * sensors is the clean fix if the fan ever audibly hunts.
+ */
+&cpu_thermal {
+	cooling-maps {
+		map0 {
+			trip = <&cpu_alert1>;
+		};
+		map1 {
+			trip = <&cpu_alert0>;
+			cooling-device = <&fan 0 4>;
+			contribution = <2048>;
+		};
+	};
+};
+
+&gpu_thermal {
+	cooling-maps {
+		map1 {
+			trip = <&gpu_threshold>;
+			cooling-device = <&fan 0 4>;
+			contribution = <2048>;
+		};
+	};
+};
