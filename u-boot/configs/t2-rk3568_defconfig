# --- kernel fallback: persistent env in the FAT boot partition + bootcount ---
# The environment is /uboot.env inside the FAT `boot` partition (p3).  ":3"
# means "partition 3 of the mmc device U-Boot booted from": rockchip
# mmc_get_env_dev() resolves it from /chosen/u-boot,spl-boot-device, so the
# same binary keeps the env on the card (mmc1, SD) and on the final eMMC
# (mmc0, &sdhci) alike.
CONFIG_ENV_IS_IN_FAT=y
