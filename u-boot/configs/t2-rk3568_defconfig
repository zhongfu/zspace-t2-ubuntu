# Booted instead of bootcmd when bootcount > bootlimit (standard U-Boot
# bootcount flow: counting happens only while upgrade_available=1).  It boots
# the previous kernel /Image.old with the same cmdline as the primary extlinux
# entry - mmc0 (eMMC) first, then mmc1 (SD card) as the rescue device - and
# leaves t2_fallback=1 so the userspace commit unit promotes the fallback slot.
CONFIG_BOOTCOUNT_ALTBOOTCMD="setenv t2_fallback 1; saveenv; setenv bootargs root=LABEL=zspace-rootfs rootfstype=ext4 rw rootwait rootflags=errors=remount-ro panic=15; if fatload mmc 0:3 ${kernel_addr_r} /Image.old; then setenv t2dev 0; else setenv t2dev 1; fatload mmc 1:3 ${kernel_addr_r} /Image.old; fi; fatload mmc ${t2dev}:3 ${fdt_addr_r} /rk3568-t2.dtb; booti ${kernel_addr_r} - ${fdt_addr_r}"
