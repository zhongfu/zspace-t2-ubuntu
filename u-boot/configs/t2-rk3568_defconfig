# --- RESET-at-power-on installer trigger ------------------------------------
# ADC + SARADC_ROCKCHIP are implied for ARM/rockchip (arch/arm/Kconfig); the
# T2's SARADC `adc-keys` nodes (ch5 = reset-key-bk, ch4 = power-key-bk) drive
# BUTTON_ADC, which makes `button power-key-bk` a boot-time test.
CONFIG_BUTTON=y
CONFIG_BUTTON_ADC=y
# --- boot command -----------------------------------------------------------
# The selector is the POWER button (ADC `power-key-bk`), not RESET: on the T2
# the RESET line is a *hardware* reset (pressing it at power-on reboots the SoC
# before U-Boot can read it - observed on hardware 2026-10-02), so the old
# `button reset-key-bk` trigger could never work.
#
# This is the **plain** image, the one that lives on the eMMC.  It boots the
# eMMC tree immediately - no boot menu to wait out, no prompt, no "press for the
# installer" nag on a board that has no card (the owner's request: two images,
# one plain for the eMMC and one for the installer).  The installer is still
# reachable deliberately: the user has to press the power button to power the
# board on anyway (the plug-in gate forbids booting on applied power), so
# *holding* that press for ~0.5 s selects the card; a normal tap boots straight
# through.  A missing eMMC tree still falls back to the card, so a wiped eMMC
# can always be recovered by inserting an installer card.
# `configs/t2-rk3568-installer_defconfig` is the other image: same board config,
# bootcmd that goes straight to the card's installer tree (it is what the card
# carries in its loader partition).
CONFIG_USE_BOOTCOMMAND=y
# --- autoboot countdown: one second, not the default two ------------------
# The autoboot countdown is dead time on every boot (measured 2 s of the ~23 s
# from the U-Boot banner to the login prompt before this change).  One second
# is kept rather than
# 0: a window on the serial console is what makes the board recoverable
# without the maskrom button (CTRL+C during the countdown reaches the U-Boot
# prompt; with 0 the only way back in is the bootROM/SD card path documented
# in docs/tinkering.md).
CONFIG_BOOTDELAY=1
CONFIG_BOOTCOMMAND="setenv t2_mode normal; if button power-key-bk; then sleep 0.4; if button power-key-bk; then setenv t2_mode installer; fi; fi; if test ${t2_mode} = installer; then if test x${t2_leds} = x1; then led power-led-green off; led power-led-red on; fi; echo T2: installer: booting the SD card; bootflow scan -lb mmc1; fi; if fatload mmc 0:3 ${loadaddr} /extlinux/extlinux.conf; then if test x${t2_leds} = x1; then led power-led-red off; led power-led-green on; fi; bootflow scan -lb mmc0; else bootflow scan -lb mmc1; fi"
# --- power-on LEDs: red in U-Boot, then Linux's gpio-leds takes over --------
# The control DT's `gpio-leds` node already carries the two front-panel power
# LEDs with the SAME labels Linux uses: "power-led-green" = gpio1 RK_PA7
# (Linux default-state "on") and "power-led-red" = gpio1 RK_PA6 (Linux
# default-state "off").  LED + LED_GPIO make `led <label> on|off` work
# (CONFIG_CMD_LED is implied by LED, but is spelled out so `led list` is
# available).
# U-Boot must not light anything until the power-on source has been read and
# judged (see the gate below), so the control DT's LED `default-state` is
# deleted in `arch/arm/dts/rk3568-t2-u-boot.dtsi` - otherwise the LED uclass
# applies it at probe, i.e. before preboot runs.  The gate then lights red only
# when the board is coming up from a reboot/reset or a power-button press; a
# fresh plug-in power-on (which is shut back off) leaves both LEDs dark.
# Linux later registers the same gpio-leds and applies its own DT defaults
# (green on, red off).
CONFIG_LED=y
CONFIG_LED_GPIO=y
CONFIG_CMD_LED=y
# --- power-on-source gate: no autoboot on a plug-in power-on ----------------
# The RK809 reports why it powered up in reg 0xf5 (i2c0 @0x20): bit6 (0x40)
# = external power applied ("plug-in"), bit7 (0x80) = power button.  The
# vendor behaviour this restores: a plug-in power-up must NOT autoboot - the
# PMIC is shut back off (halt), so the board only boots when the user presses
# the power button (which restarts the PMIC with on_source bit7 set).
# Env `t2_boot_on_plugin`: 1 = force a normal autoboot even on plug-in; unset
# (the documented default) = button-only boot.  The preboot hook normalises
# the unset case to 0.
#
# An **OS-initiated reboot** is the other way the board comes up, and it must
# autoboot: Linux's `reboot` calls the rk8xx driver's restart handler, which
# writes DEV_RST (bit2) into the RK809's sys_cfg3 (0xf4).  What that *does* is
# selected by the same register's RST_FUNC field (bits 6-7): 0 = "reset the
# dev" (the PMU restarts alone and the rails drop - the board ends up off, with
# no U-Boot output and nothing to explain it, which is exactly what
# `systemctl reboot` did on 2026-10-02), 1 = "reset the reg only", 2 = reset
# the reg + RESETB.  preboot therefore sets RST_FUNC=2 first, so the reboot
# pulls RESETB: the SoC restarts with the rails up and the PMIC latches
# ON_SOURCE bit4 (RESTART_RESETB).  The gate then boots - only a *fresh*
# plug-in power-on (bit6 set, no restart bit) is still shut back off.
#
# A **SoC-only** restart (what the wedge above leaves behind: the DW watchdog
# resets the SoC without the PMIC being involved) leaves ON_SOURCE untouched, so
# on a plug-in power source the board would be shut back off.  The gate
# therefore also reads the SoC's own reset cause - RK3568 CRU GLB_RST_ST
# (0xfdd20000 + 0xe0, the offset from drivers/clk/rockchip/clk.h's
# RK3568_GLB_RST_ST): 0 = POR (a genuine cold power-on), BIT(0/1) = global
# software reset, BIT(2/3) = thermal, BIT(4/5) = watchdog - and boots whenever
# it is non-zero, i.e. whenever the SoC restarted by itself.  Values are echoed
# on every boot for the field logs.
#
# NB: `i2c read` takes chip first, but `i2c write` takes the *memory* address
# first (`i2c write <memaddr> <chip> <addr> <len>`) - getting that backwards
# silently writes to the wrong chip and returns -121 (EREMOTEIO), which is how
# the first version of this hook did nothing.
#
# Mechanism chosen = shell (CONFIG_CMD_I2C + i2c read/write + setexpr + poweroff),
# not the rk8xx driver hook CONFIG_ROCKCHIP_RK8XX_DISABLE_BOOT_ON_POWERON.
# That hook does the same read-and-shutdown inside the PMIC probe, but it is
# compile-time only and cannot honour the env override; the shell form keeps
# the override and needs no driver change.  CMD_SETEXPR masks bit6 out of the
# register byte; CMD_POWEROFF reaches the PMIC via the rk8xx sysreset driver,
# which the DT's `system-power-controller` property binds (CONFIG_SYSRESET=y).
CONFIG_CMD_POWEROFF=y
# CONFIG_USE_PREBOOT: preboot runs in main_loop BEFORE bootdelay_process()/
# autoboot_command() (common/main.c), i.e. earlier than bootcmd and before
# the 2 s autoboot delay.
CONFIG_USE_PREBOOT=y
CONFIG_PREBOOT="mw.b ${loadaddr} 0 1; i2c dev 0; i2c read 0x20 0xf5 1 ${loadaddr}; setexpr.b t2_plug *${loadaddr} '&' 0x40; setexpr.b t2_rstrt *${loadaddr} '&' 0x10; setexpr.b t2_btn *${loadaddr} '&' 0x80; setexpr.l t2_rc *fdd200e0; echo T2 power-on: pmic=0x${t2_plug}+0x${t2_rstrt} reset-cause=0x${t2_rc}; mw.b ${loadaddr} 0 1; i2c read 0x20 0xf4 1 ${loadaddr}; setexpr.b t2_rst *${loadaddr} '&' 0x3f; setexpr.b t2_rst ${t2_rst} '|' 0x80; mw.b ${loadaddr} ${t2_rst}; i2c write ${loadaddr} 0x20 0xf4 1; i2c read 0x20 0xf4 1 ${loadaddr}; setexpr.b t2_cfg3 *${loadaddr}; echo T2 sys_cfg3=0x${t2_cfg3} (want bits 7-6 = RST_FUNC 2); setenv t2_shut 0; if test x${t2_boot_on_plugin} = x; then setenv t2_boot_on_plugin 0; fi; if test ${t2_boot_on_plugin} -eq 0; then if test ${t2_plug} -ne 0; then setenv t2_shut 1; fi; if test ${t2_rstrt} -ne 0; then setenv t2_shut 0; fi; if test ${t2_rc} -ne 0; then setenv t2_shut 0; fi; fi; if test ${t2_shut} -ne 0; then echo T2 powered on by plug-in - powering off; poweroff; fi; setenv t2_leds 0; if test ${t2_rstrt} -ne 0; then setenv t2_leds 1; fi; if test ${t2_btn} -ne 0; then setenv t2_leds 1; fi; if test ${t2_rc} -ne 0; then setenv t2_leds 1; fi; if test x${t2_leds} = x1; then led power-led-red on; led power-led-green off; fi"
